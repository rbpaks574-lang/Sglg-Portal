# ==========================================
# SGLG Portal - Render Production Environment
# ==========================================

APP_NAME="SGLG Portal"
APP_ENV=production
APP_KEY=base64:PRbhPQ9I21L5fjm5LcwGeDQaMNugoqc3CuAkVTs6Bf4=
APP_DEBUG=false
APP_URL=https://sglg-portal-backend.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------
# TiDB Cloud Serverless Connection
# ------------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=sglg_portal
DB_USERNAME=your_tidb_user.root
DB_PASSWORD=your_tidb_password
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# ------------------------------------------
# Storage & Sessions
# ------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ------------------------------------------
# Optional Boot Seed (Set true for 1st deploy to seed default Admin / Barangay users)
# ------------------------------------------
DB_SEED_ON_BOOT=true
